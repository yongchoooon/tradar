{
  "family": "tradar-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "4096",
  "memory": "16384",
  "ephemeralStorage": { "sizeInGiB": 80 },
  "executionRoleArn": "arn:aws:iam::082351608649:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::082351608649:role/tradar-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "tradar-backend",
      "image": "REPLACED_BY_WORKFLOW",
      "essential": true,
      "portMappings": [{ "containerPort": 8000, "protocol": "tcp" }],
      "environment": [
        { "name": "APP_ENV", "value": "prod" },
        { "name": "HF_HOME", "value": "/tmp/hf" },
        { "name": "TRANSFORMERS_CACHE", "value": "/tmp/hf/transformers" },
        { "name": "HF_HUB_CACHE", "value": "/tmp/hf/hub" },
        { "name": "HF_HUB_ENABLE_HF_TRANSFER", "value": "0" }
      ],
      "secrets": [
        {
          "name": "HF_TOKEN",
          "valueFrom":  "arn:aws:ssm:ap-northeast-2:082351608649:parameter/tradar/prod/hf-token"
        },
        {
          "name": "HUGGINGFACE_HUB_TOKEN",
          "valueFrom":  "arn:aws:ssm:ap-northeast-2:082351608649:parameter/tradar/prod/hf-token"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:082351608649:parameter/tradar/prod/database-url"
        },
        {
          "name": "OPENSEARCH_URL",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:082351608649:parameter/tradar/prod/opensearch-url"
        },
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:082351608649:parameter/tradar/prod/openai-api-key"
        },
        {
          "name": "KIPRIS_ACCESS_KEY",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:082351608649:parameter/tradar/prod/kipris-access-key"
        },
        {
          "name": "TRADEMARK_LLM_MODEL",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:082351608649:parameter/tradar/prod/trademark-llm-model"
        },
        {
          "name": "SIMULATION_LLM_MODEL",
          "valueFrom": "arn:aws:ssm:ap-northeast-2:082351608649:parameter/tradar/prod/simulation-llm-model"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/tradar-backend",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
