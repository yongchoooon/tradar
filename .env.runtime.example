# Copy to .env.runtime, replace every CHANGE_ME value, and chmod 600 the file.

# Application
APP_ENV=prod
CORS_ALLOWED_ORIGINS=https://tradar.example.com

# Local PostgreSQL and OpenSearch
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
DATABASE_URL=postgresql://postgres:CHANGE_ME_URL_ENCODED_PASSWORD@db:5432/tradar
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_VERIFY_CERTS=false

# External APIs -- use newly rotated credentials, not the exposed AWS-era values
OPENAI_API_KEY=CHANGE_ME
GEMINI_API_KEY=CHANGE_ME
KIPRIS_ACCESS_KEY=CHANGE_ME
HF_TOKEN=CHANGE_ME
HUGGINGFACE_HUB_TOKEN=CHANGE_ME

# LLM settings
TRADEMARK_LLM_MODEL=gpt-5-nano
SIMULATION_LLM_MODEL=gemini-3-flash-preview
SIMULATION_LLM_THINKING_LEVEL=high

# Admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
ADMIN_COOKIE_SECRET=CHANGE_ME_RANDOM_64_PLUS_CHARACTERS
ADMIN_SESSION_TTL_SECONDS=86400

# API <-> desktop worker (Docker-internal WebSocket)
DESKTOP_WORKER_TOKEN=CHANGE_ME_RANDOM_WORKER_TOKEN
DESKTOP_WORKER_ID_ALLOWLIST=desktop-1
SEARCH_TIMEOUT_SECONDS=120
TOPK_DEFAULT=18
WORKER_ID=desktop-1
WORKER_WS_URL=ws://api:8000/ws/worker
WORKER_TOKEN=CHANGE_ME_SAME_AS_DESKTOP_WORKER_TOKEN
WORKER_REQUIRE_GPU=true
WORKER_HEARTBEAT_SECONDS=20
WORKER_RECONNECT_MIN_SECONDS=1
WORKER_RECONNECT_MAX_SECONDS=30

# Local data and models
TRADAR_IMAGE_ROOT=../tradar-data
MEDIA_ALLOWED_ROOTS=/data/images
EMBED_DEVICE=cuda:0
METACLIP_MODEL_NAME=/app/models/metaclip
DINOV2_MODEL_NAME=/app/models/dinov2

# Cloudflare R2 (S3-compatible API)
R2_ENABLED=true
R2_BUCKET=tradar-data
R2_LOG_BUCKET=tradar-data
R2_ENDPOINT_URL=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_REGION=auto
R2_IMAGE_PREFIX=queries
R2_LOG_PREFIX=logs
R2_PRESIGN_TTL_SECONDS=600
R2_LOGS_ENABLED=true
R2_UPLOAD_OPENAI_USAGE=true

# Base64 is only a local emergency fallback; keep disabled in production.
ALLOW_BASE64_FALLBACK=false
BASE64_MAX_IMAGE_BYTES=204800

# Compose network used by docker-compose.desktop.yml
DESKTOP_COMPOSE_NETWORK=tradar_default
